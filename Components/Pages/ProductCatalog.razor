@page "/products"
@rendermode InteractiveServer

<PageTitle>Product Catalog</PageTitle>

@if (!string.IsNullOrEmpty(cartMessage))
{
    <div style="background-color: #d4edda; border: 1px solid #c3e6cb; color: #155724; padding: 15px; margin: 10px 0; border-radius: 5px; position: relative;">
        @cartMessage
        <button type="button" @onclick="ClearMessage" style="position: absolute; right: 10px; top: 10px; background: none; border: none; font-size: 18px; cursor: pointer;">&times;</button>
    </div>
}

<ProductList 
    Title="Featured Products"
    Products="@products"
    OnProductAddedToCart="@HandleProductAddedToCart" />

@code {
    private string cartMessage = string.Empty;

    private List<Product> products = new List<Product>()
    {
        new Product
        {
            Id = 1,
            Name = "Wireless Headphones",
            Description = "Premium noise-cancelling headphones",
            Price = 199.99m,
            ImageUrl = "https://via.placeholder.com/300x200?text=Headphones"
        },
        new Product
        {
            Id = 2,
            Name = "Smart Watch",
            Description = "Fitness tracking and smart notifications",
            Price = 299.99m,
            ImageUrl = "https://via.placeholder.com/300x200?text=Smart+Watch"
        }
    };

    private void HandleProductAddedToCart(Product product)
    {
        cartMessage = $"🛒 {product.Name} added to cart! (${product.Price:F2})";
        StateHasChanged(); 
    }

    private void ClearMessage()
    {
        cartMessage = string.Empty;
    }
}